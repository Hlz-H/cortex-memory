{
  "name": "cortex-memory",
  "version": "0.1.0",
  "description": "Cortex - Local AI Memory Engine with 4-tier storage, agents, and MCP",
  "main": "dist/index.js",
  "bin": {
    "cortex": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node fix-esm-imports.js",
    "dev": "tsc && node dist/index.js serve --port 3456",
    "start": "node dist/index.js serve",
    "cli": "node dist/index.js",
    "mcp": "node dist/index.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-memory",
    "local-ai",
    "ollama",
    "mcp",
    "agent",
    "sqlite",
    "knowledge-graph",
    "memory-system"
  ],
  "author": "Cortex Team",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "hono": "^4.6.8",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
